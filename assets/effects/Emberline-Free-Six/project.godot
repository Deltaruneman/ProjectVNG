; Emberline — six original procedural 2D combat effects.
config_version=5

[application]
config/name="Emberline — Combat VFX Sample"
run/main_scene="res://emberline/demo/showcase.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=960
window/size/window_width_override=1200
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.039, 0.067, 1)

[audio]
driver/driver="Dummy"
